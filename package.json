{
  "name": "lines",
  "private": true,
  "version": "0.4.0",
  "description": "Beautiful, simple, local-first notes. Write in Markdown, see formatted text.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:site": "VITE_SITE=1 vite build --base ./ --outDir dist-site/app && bun site/build.mjs",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json && tsc -p tests/tsconfig.json && tsc -p tools/tsconfig.json",
    "lint": "oxlint --deny-warnings",
    "test": "bun test --preload ./tests/unit/setup.ts tests/unit",
    "test:browser": "bun test --preload ./tests/browser/setup.ts --timeout 30000 tests/browser",
    "bench": "bun scripts/bench.mjs",
    "notices": "bun scripts/notices.mjs",
    "qa-notes": "bun scripts/qa-notes.mjs",
    "qa-shots": "bun scripts/qa-shots.mjs",
    "i18n": "bun scripts/i18n-check.mjs",
    "tex-assets": "bun scripts/tex-assets.mjs",
    "openscad-assets": "bun scripts/openscad-assets.mjs",
    "swatch": "bun tools/themes/swatch.ts",
    "adapt-theme": "bun tools/themes/adapt.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@excalidraw/excalidraw": "0.18.1",
    "@excalidraw/mermaid-to-excalidraw": "3.1.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/fira-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@ironcalc/wasm-xlsx": "0.9.1",
    "@lezer/common": "^1.5.4",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "@lucide/svelte": "^1.63.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-http": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "asciinema-player": "3.17.0",
    "aws4fetch": "^1.0.20",
    "bits-ui": "^2.20.2",
    "json5": "2.2.3",
    "katex": "0.19.1",
    "mermaid": "12.2.0",
    "modern-screenshot": "4.7.0",
    "occt-import-js": "0.0.23",
    "pele": "1.12.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sql-formatter": "15.9.0",
    "texlyre-busytex": "1.4.1",
    "three": "0.186.1",
    "wavedrom": "3.8.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@tsconfig/svelte": "^5.0.8",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@types/three": "~0.186.0",
    "oxlint": "^1.90.0",
    "playwright": "^1.64.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "overrides": {
    "@excalidraw/mermaid-to-excalidraw": "3.1.0"
  }
}
