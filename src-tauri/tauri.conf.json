{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "lines",
  "version": "0.5.0",
  "identifier": "com.overtio.lines",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "lines",
        "width": 1180,
        "height": 760,
        "minWidth": 360,
        "minHeight": 400,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "visible": false,
        "dragDropEnabled": false,
        "trafficLightPosition": { "x": 20, "y": 28 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: sfsymbol:; media-src 'self' blob: https:; font-src 'self' blob: data:; connect-src 'self' ipc: http://ipc.localhost; frame-src 'self' blob: https://open.spotify.com https://w.soundcloud.com"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4QUFGODQxRkY2MEQ1OTMKUldTVDFXRC9RZmlxU011NmFSSVIrTmROcDlSN2JnWDlXS2REN1lWRml4QzdPc3AySGt6Mld5OHEK",
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Beautiful, simple notes",
    "copyright": "Copyright (C) 2026 lines contributors. Licensed under AGPL-3.0.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
